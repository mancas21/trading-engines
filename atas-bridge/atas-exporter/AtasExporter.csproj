<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="ATAS.Indicators">
      <HintPath>C:\Program Files\ATAS X\ATAS.Indicators.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="ATAS.Types">
      <HintPath>C:\Program Files\ATAS X\ATAS.Types.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="OFT.Platform.Core">
      <HintPath>C:\Program Files\ATAS X\OFT.Platform.Core.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>C:\Program Files\ATAS X\Newtonsoft.Json.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="OFT.Attributes">
      <HintPath>C:\Program Files\ATAS X\OFT.Attributes.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="OFT.Rendering">
      <HintPath>C:\Program Files\ATAS X\OFT.Rendering.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <!-- System.Drawing.Common carries StringAlignment / DashStyle, which
         OFT.Rendering's public signatures (RenderStringFormat, RenderPen)
         expose. ATAS ships it, so reference the same copy the platform runs. -->
    <Reference Include="System.Drawing.Common">
      <HintPath>C:\Program Files\ATAS X\System.Drawing.Common.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>
</Project>
