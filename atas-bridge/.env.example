# ATAS Bridge — Required Environment Variables
# Copy this file to .env and fill in your values.

# Telegram bot token (REQUIRED for Telegram alerts)
# Get from @BotFather on Telegram
TELEGRAM_TOKEN=your_telegram_bot_token_here

# Telegram chat ID (REQUIRED for Telegram alerts)
# Your personal chat ID to receive messages
TELEGRAM_CHAT_ID=your_chat_id_here

# Bridge shared-secret token (OPTIONAL but recommended)
# Used to authenticate POST/PUT endpoints. If empty, auth is disabled.
BRIDGE_TOKEN=your_bridge_secret_here

# Server config (OPTIONAL, defaults shown)
# HOST=127.0.0.1
# PORT=8000
# BUFFER_SIZE=12
