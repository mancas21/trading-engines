# Claves del testnet de Binance USDⓈ-M Futures.
# Rellena este fichero TÚ, no lo pegues en el chat ni en un issue.
# El motor solo imprime los últimos 4 caracteres.
#
# Dónde se generan: https://testnet.binancefuture.com  ->  Log In (GitHub/email)
#   ->  API Key  ->  Create API  ->  permisos: Reading + Futures (no retiros).
# OJO: las claves del testnet SPOT (testnet.binance.vision) NO sirven aquí.

BINANCE_TESTNET_KEY=
BINANCE_TESTNET_SECRET=

# Host (déjalo vacío para testnet; demo de producción: https://demo-fapi.binance.com)
BINANCE_TESTNET_BASE=

# Seguridad local
ALLOW_ORDERS=0
# Tope de exposicion NUEVA (los cierres reduceOnly no lo usan). 650 USDT deja
# que 0,25% de riesgo con stops de ~2-2,7% mande en el tamano, no el tope.
MAX_ORDER_NOTIONAL_USD=650
ALLOW_SYMBOLS=ETHUSDT,SOLUSDT,SUIUSDT,XRPUSDT

# ─── Alpaca (acciones US, segunda pata de ejecución) ───
# La autenticación NO va aquí: la gestiona el CLI (`alpaca profile login`,
# se hace una vez). Este fichero solo lleva los topes locales.
# Binario: exportar ALPACA_CLI si no está en PATH ni en ~/go/bin/alpaca.exe
ALLOW_ALPACA_ORDERS=0
MAX_ALPACA_NOTIONAL_USD=1000
ALLOW_ALPACA_SYMBOLS=AAPL,SPY

# Claves API del dashboard (la cuenta paper -> API keys; empiezan por PK).
# Las mete `python execution/set_alpaca_mcp.py` sin verlas en pantalla: las
# lee el MCP server de ZCode via --env-file. El login OAuth del CLI NO sirve.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
