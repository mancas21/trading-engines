//@version=6
indicator("EW Live Tracker [Auto]", overlay=true, max_labels_count=500)
pivLen   = input.int(5, "Pivot strength (bars L/R)", minval=1, group="Swings")
lookback = input.int(100, "Swing lookback (bars)", minval=20, group="Swings")
minSwing = input.float(0.8, "Min swing % (noise filter)", step=0.1, group="Swings")
showFib  = input.bool(true, "Show W2 fib lines", group="Display")
showPiv  = input.bool(true, "Show pivot markers + prices", group="Display")
showTable = input.bool(true, "Show dashboard", group="Display")
ph = ta.pivothigh(high, pivLen, pivLen)
pl = ta.pivotlow(low, pivLen, pivLen)
plotshape(ph, title="Swing high", style=shape.triangledown, location=location.abovebar, color=color.gray, size=size.tiny)
plotshape(pl, title="Swing low", style=shape.triangleup, location=location.belowbar, color=color.gray, size=size.tiny)
if showPiv and not na(ph)
    label.new(bar_index - pivLen, ph, "H " + str.tostring(ph, format.mintick), style=label.style_none, textcolor=color.gray, size=size.small)
if showPiv and not na(pl)
    label.new(bar_index - pivLen, pl, "L " + str.tostring(pl, format.mintick), style=label.style_none, textcolor=color.gray, size=size.small)
hi  = ta.highest(high, lookback)
lo  = ta.lowest(low, lookback)
hib = ta.highestbars(high, lookback)
lob = ta.lowestbars(low, lookback)
upLeg = hib < lob and (hi - lo) / lo * 100 >= minSwing
var float w1_top = na
var float w1_low = na
if upLeg
    w1_top := hi
    w1_low := lo
anchored = not na(w1_top) and not na(w1_low)
w1range = anchored ? w1_top - w1_low : na
ret = anchored ? (high - w1_low) / w1range : na
l50  = anchored ? w1_low + w1range * 0.5 : na
l618 = anchored ? w1_low + w1range * 0.618 : na
zone = not anchored ? "No impulse" : ret < 0.5 ? "W2 building" : ret < 0.618 ? "W2 typical" : ret < 1.0 ? "W2 DEEP" : "INVALIDATED"
zcolor = not anchored ? color.gray : ret < 0.5 ? color.gray : ret < 0.618 ? color.teal : ret < 1.0 ? color.orange : color.red
plot(showFib ? l50 : na, "W2 50%", color=color.new(color.teal, 0), style=plot.style_linebr)
plot(showFib ? l618 : na, "W2 61.8%", color=color.new(color.orange, 0), style=plot.style_linebr)
plot(anchored ? w1_top : na, "Invalidation", color=color.new(color.red, 0), style=plot.style_linebr)
crossUp = ta.crossover(close, w1_top)
revBear = anchored and ret >= 0.5 and close < math.min(close[1], close[2]) and close < open
brkOut = anchored and crossUp
plotshape(revBear, title="W2 reversal", style=shape.triangledown, location=location.abovebar, color=color.orange, size=size.small)
plotshape(brkOut, title="W3 breakout", style=shape.triangleup, location=location.belowbar, color=color.teal, size=size.small)
var table dash = table.new(position.top_right, 2, 5, bgcolor=color.new(color.black, 20))
if showTable and barstate.islast
    table.cell(dash, 0, 0, "W2 retrace", text_color=color.gray)
    table.cell(dash, 1, 0, anchored ? str.tostring(ret * 100, "#.#") + "%" : "n/a", text_color=zcolor)
    table.cell(dash, 0, 1, "Zone", text_color=color.gray)
    table.cell(dash, 1, 1, zone, text_color=zcolor)
    table.cell(dash, 0, 2, "Invalid.", text_color=color.gray)
    table.cell(dash, 1, 2, anchored ? str.tostring(w1_top, format.mintick) + " (" + str.tostring((w1_top - close) / close * 100, "#.##") + "% away)" : "n/a", text_color=color.red)
    table.cell(dash, 0, 3, "Anchors", text_color=color.gray)
    table.cell(dash, 1, 3, anchored ? str.tostring(w1_low, format.mintick) + " -> " + str.tostring(w1_top, format.mintick) : "n/a", text_color=color.gray)
    table.cell(dash, 0, 4, "Note", text_color=color.gray)
    table.cell(dash, 1, 4, "Pivots confirm " + str.tostring(pivLen) + " bars late", text_color=color.gray)
alertcondition(anchored and ret >= 0.618 and ret[1] < 0.618, title="W2 61.8% reached", message="W2 entered deep zone (61.8%)")
alertcondition(anchored and high >= w1_top, title="Invalidation broken", message="W1 top breached - bearish count invalid")
alertcondition(revBear, title="W2 reversal print", message="Bearish reversal inside W2 zone")
alertcondition(brkOut, title="W3 breakout", message="Close above W1 top - wave 3 breakout")
