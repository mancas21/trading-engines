  "cvd": {
    "enabled": true,
    "smooth_len": 5,
    "div_lookback": 20,
    "pivot_len": 5
  },
  "rsi": {
    "enabled": true,
    "length": 14,
    "overbought": 70,
    "oversold": 30,
    "pivot_len": 5,
    "div_lookback": 20
  },
  "macd": {
    "enabled": true,
    "fast": 12,
    "slow": 26,
    "signal": 9,
    "pivot_len": 5,
    "div_lookback": 20,
    "histogram_flip": true
  },
  "stochastic": {
    "enabled": true,
    "k_len": 14,
    "d_len": 3,
    "smooth": 3,
    "overbought": 80,
    "oversold": 20
  },
  "volatility": {
    "enabled": true,
    "bb_len": 20,
    "bb_mult": 2.0,
    "bb_squeeze_pct": 20.0,
    "bb_width_lookback": 100,
    "atr_len": 14,
    "atr_expansion_mult": 1.8
  },
  "general": {
    "check_interval": 5,
    "enable_notifications": true,
    "enable_sound": true,
    "max_workers": 10,
    "log_level": "INFO",
    "max_history_bars": 200,
    "health_port": 8080,
    "health_enabled": true,
    "confluence_required": 0,
    "regime_filter_enabled": false,
    "regime_trend_len": 50,
    "tf_consolidation_enabled": true,
    "blackout_enabled": true,
    "blackout_seconds": 300,
    "signal_cooldown_seconds": 600
  },
  "exchange": {
    "id": "binanceusdm",
    "testnet": false,
    "api_key": "",
    "secret": "",
