# Quant Alert Engine — Environment Variables
# Copy to .env and fill secrets. .env is gitignored.
# Env vars take precedence over config.json (via pydantic-settings).

# ── Exchange (optional — public data works without keys) ──
EXCHANGE__API_KEY=
EXCHANGE__SECRET=
EXCHANGE__ID=binanceusdm
EXCHANGE__TESTNET=false

# ── Telegram (optional) ──
TELEGRAM__ENABLED=false
TELEGRAM__TOKEN=your_bot_token_here
TELEGRAM__CHAT_ID=your_chat_id_here

# Legacy flat env vars (e.g. TELEGRAM_BOT_TOKEN/CHAT_ID from older docs) are
# automatically migrated to the nested TELEGRAM__TOKEN/CHAT_ID form at startup
# by config_schema._apply_legacy_env_migrations(). Plain nested form above is preferred.

# ── Bridge agent (optional) ──
BRIDGE__ENABLED=true
BRIDGE__URL=http://127.0.0.1:8000/quant-alert
BRIDGE__FILTER_URL=http://127.0.0.1:8000/quant/filter
BRIDGE__TIMEOUT_SECONDS=2.0

# ── General ──
GENERAL__CHECK_INTERVAL=5
GENERAL__LOG_LEVEL=INFO
GENERAL__HEALTH_ENABLED=true
GENERAL__HEALTH_PORT=8080
GENERAL__HEALTH_HOST=127.0.0.1
# Set to 0.0.0.0 to expose health/metrics to LAN (no auth)
