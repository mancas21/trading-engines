# ── trading-engines monorepo ─────────────────────────────────────────────
# Python
venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Node
node_modules/
dist/
build/

# .NET build output — these were tracked (56 files) and showed as modified on
# every single build, burying real changes in `git status`. Regenerate with
# `dotnet build -c Release`; the deployable copy lives at
# %APPDATA%/ATAS X/Indicators/AtasExporter.dll, not in the repo.
obj/
bin/
*.user

# Runtime / logs / data (regenerable or machine-local)
*.log
*.log.*
*.db
*.db-journal
*.jsonl
*.bak-*
*.pid
atas-bridge/_*.json
data/
logs/
screenshots/
card_live/raw/

# Stray runtime artifacts that don't match a pattern above:
# INFO is a log the engine wrote because log_file was passed as "INFO"
quant-alert-engine/INFO
*.err
.watchdog_failcount

# Secrets — NEVER commit live .env files (ship .env.example instead)
.env
!.env.example

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.tmp
*.bak

# Rediseño: registro de evidencia (crece cada 30s; no versionar)
reader/reader.db
reader/reader.db-wal
reader/reader.db-shm
# Regla 8: registro de perdidas del grabador (runtime; crece con cada veredicto
# resuelto que va mas de 1% en contra). No se versiona.
reader/audit_losses.jsonl
# objetivo del símbolo ATAS (config local, con reason/ timestamps propios)
atas-bridge/atas_target.json
# FASE 4: estado de notificacion (por simbolo, ultimo veredicto enviado)
reader/notify_state.json
# supervisor del reader: logs + status de runtime
reader/supervisor.log
reader/supervisor_stdout.log
reader/supervisor_stderr.log
reader/supervisor_launch.log
reader/supervisor_status.json
reader/__pycache__/

# scanner-engine runtime
scanner-engine/data/
scanner-engine/*.db
scanner-engine/scanner.db
scanner-engine/tests/_ssl_*.py
