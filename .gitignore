# ── trading-engines monorepo ─────────────────────────────────────────────
# Python
venv/
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Node
node_modules/
dist/
build/

# .NET build output — these were tracked (56 files) and showed as modified on
# every single build, burying real changes in `git status`. Regenerate with
# `dotnet build -c Release`; the deployable copy lives at
# %APPDATA%/ATAS X/Indicators/AtasExporter.dll, not in the repo.
obj/
bin/
*.user
# Visual Studio's build cache under the exporter (dtbcache.v2 etc.): same
# disease as obj/ — machine-local, modified on every build.
.vs/

# Runtime / logs / data (regenerable or machine-local)
*.log
*.log.*
*.db
*.db-journal
*.jsonl
*.bak-*
*.pid
atas-bridge/_*.json
data/
logs/
screenshots/
card_live/raw/

# Stray runtime artifacts that don't match a pattern above:
# INFO is a log the engine wrote because log_file was passed as "INFO"
quant-alert-engine/INFO
*.err
.watchdog_failcount
.engines_watchdog_*_fails

# Secrets — NEVER commit live .env files (ship .env.example instead)
.env
!.env.example

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
*.tmp
*.bak

# Rediseño: registro de evidencia (crece cada 30s; no versionar)
reader/reader.db
reader/reader.db-wal
reader/reader.db-shm
# Regla 8: registro de perdidas del grabador (runtime; crece con cada veredicto
# resuelto que va mas de 1% en contra). No se versiona.
reader/audit_losses.jsonl
# objetivo del símbolo ATAS (config local, con reason/ timestamps propios)
atas-bridge/atas_target.json
# FASE 4: estado de notificacion (por simbolo, ultimo veredicto enviado)
reader/notify_state.json
# supervisor del reader: logs + status de runtime
reader/supervisor.log
reader/supervisor_stdout.log
reader/supervisor_stderr.log
reader/supervisor_launch.log
reader/supervisor_status.json
reader/__pycache__/

# scanner-engine runtime
scanner-engine/data/
scanner-engine/*.db
scanner-engine/scanner.db
scanner-engine/tests/_ssl_*.py

# 2026-10-13 — estado de RUNTIME del reader. Estos tres los escribe el proceso
# en cada ciclo y son machine-local: lock de instancia, fingerprint de la
# medicion de las reglas 6/7 y contador de racha del gate multi-venue.
# Versionarlos haria que cada commit los traiga con el estado de otra
# maquina, que es justo lo que un lock de instancia no debe hacer.
reader/reader_supervisor.lock
reader/audit_atas_state.json
reader/dom_gate_state.json
# Estado de la ventana de persistencia de las condiciones 6/7 (el grabador lo
# escribe en cada ciclo). Es estado de ejecucion: no se versiona.
reader/condition_window_state.json

# 2026-10-13 — scripts de diagnostico de una sesion concreta. Se conservan
# porque documentan COMO se midio lo que motivo la cuarentena de la regla 6
# (n_eff=2.7), pero no son parte del motor.
reader/_diag_rule8.py

# 2026-10-13 — artefactos del scorecard RETIRADO en a93147f. Se conservan
# como medida historica reproducible (build_scorecard_calibration.py genero
# el .json), pero ninguna ruta de produccion los carga: verdict.py ya no
# llama a scorecard() y la carga de _CAL es codigo muerto.
reader/scorecard_calibration.json
reader/tv_structure_cache.json
